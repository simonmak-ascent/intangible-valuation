# Intangible Valuation — the web application image.
#
# The repository had no Dockerfile for the site: `Dockerfile` builds the stdio MCP
# server, but the deployed `intangible-valuation` container (port 3121) runs the
# Next.js app, so it could not be rebuilt from anything here (OI-40). This is that
# missing file.
#
# `next.config.ts` sets `output: "standalone"`, so the run stage needs only the
# standalone bundle plus the static assets and `public/`.

FROM node:22-slim AS deps
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

FROM node:22-slim AS build
WORKDIR /app
RUN corepack enable
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm build

# The library reference is generated from the same source as the library itself, so the docs a reader
# gets describe the code that runs. mkdocstrings renders the docstrings, which the Next app cannot do —
# and the MkDocs site was previously built in CI and published nowhere.
FROM python:3.12-slim AS docs
WORKDIR /src
ENV PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
COPY mcp_server ./mcp_server
COPY mkdocs.yml ./
COPY docs ./docs
COPY constraints-docs.txt ./
# -c constraints-docs.txt pins the whole transitive set, not just the three top-level packages: the
# packages that actually decide the rendered HTML (mkdocstrings-python, mkdocs-autorefs,
# pymdown-extensions, Markdown) are transitive, so pinning only mkdocs/mkdocs-material/mkdocstrings
# would leave the published reference free to change between two builds of the same commit.
RUN pip install --quiet --upgrade pip \
 && pip install --quiet -c constraints-docs.txt ".[docs]" \
 && mkdocs build --strict --site-dir /site

FROM node:22-slim AS run
WORKDIR /app
RUN useradd --uid 1001 --create-home app
# HOSTNAME must be 0.0.0.0, never 127.0.0.1: the i18n middleware otherwise rewrites
# to an absolute localhost URL, proxies to itself and returns 500 (standards.md).
ENV NODE_ENV=production \
    PORT=3121 \
    HOSTNAME=0.0.0.0 \
    NEXT_TELEMETRY_DISABLED=1
COPY --from=build --chown=1001:1001 /app/.next/standalone ./
COPY --from=build --chown=1001:1001 /app/.next/static ./.next/static
COPY --from=build --chown=1001:1001 /app/public ./public
# The library reference, built from the same commit (see the docs stage above), served as static files.
COPY --from=docs --chown=1001:1001 /site ./public/docs
USER 1001
EXPOSE 3121
CMD ["node", "server.js"]
