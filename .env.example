# Environment for the Intangible Valuation web app.
#
# There is no database, no auth and no billing. The account surface was deleted on 2026-11-19, and the
# benchmark records moved from SurrealDB into `data/benchmarks.json`, which is bundled into the build —
# so there is no connection string, no `AUTH_SECRET`, no `STRIPE_*` and no `NEXTAUTH_*`. The running
# container carries only PORT.

# Observability. Error reporting is active only when this is set; the privacy policy describes what is
# sent, and `sentry.server.config.ts` strips the request body from any report.
NEXT_PUBLIC_SENTRY_DSN=

# Site URL (used by sitemap/robots/metadata)
NEXT_PUBLIC_SITE_URL=https://intangible-valuation.ascent-partners.com
