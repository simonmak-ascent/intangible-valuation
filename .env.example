# Environment for the Intangible Valuation web app.
# There is no auth and no billing (removed 2026-11-19), so there is no
# NEXTAUTH_SECRET, no STRIPE_*, and no OAuth client. The running container carries only PORT.

# SurrealDB — for `pnpm db:migrate` / `pnpm db:seed` only, never for the deployed web container.
#
# Do NOT set these on iv-web. The client falls back to root/root, and treats an empty password as the
# literal "root"; record permissions do not bind a root connection; and `GET /v1/benchmarks` still
# interpolates its query parameters. A wired web container is therefore an unauthenticated path to the
# database as superuser. Without a store that route answers 503 BENCHMARKS_UNAVAILABLE, which is the
# correct behaviour. These are commented out so that copying this file does not wire them.
#
# SURREALDB_URL=
# SURREALDB_NS=intangible_valuation
# SURREALDB_DB=production
# SURREALDB_USER=
# SURREALDB_PASS=

# Observability
NEXT_PUBLIC_SENTRY_DSN=

# Site URL (used by sitemap/robots/metadata)
NEXT_PUBLIC_SITE_URL=https://intangible-valuation.ascent-partners.com
