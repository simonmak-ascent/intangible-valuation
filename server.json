{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.simonplmak-cloud/intangible-valuation",
  "title": "Intangible Asset Valuation MCP Server",
  "description": "Intangible asset valuation: 14 tools, 124+ formulas for IP, technology, goodwill, PPA, impairment.",
  "version": "2.0.2",
  "websiteUrl": "https://intangible-valuation.simonmak.com",
  "repository": {
    "url": "https://github.com/simonplmak-cloud/intangible-valuation",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://intangible-valuation.simonmak.com/api/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "intangible-valuation",
      "version": "2.0.1",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--from",
          "value": "intangible-valuation"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "value": "intangible-valuation-mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/simonplmak-cloud/intangible-valuation/main/public/favicon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    }
  ]
}
